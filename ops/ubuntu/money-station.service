# Managed by Money Station
[Unit]
Description=Money Station isolated static frontend
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=money-station
RuntimeDirectoryMode=0700
WorkingDirectory=/srv/money-station/current/public
ExecStartPre=/usr/sbin/nginx -t -p /run/money-station/ -c /etc/money-station/nginx.conf
ExecStart=/usr/sbin/nginx -p /run/money-station/ -c /etc/money-station/nginx.conf
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=10
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
ReadOnlyPaths=/srv/money-station /etc/money-station
ReadWritePaths=/run/money-station
LimitNOFILE=1024
TasksMax=32
MemoryMax=128M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
