# Public build-time configuration. Never put wallet keys, note secrets or API keys here.
# Keep the wallet on the configured test network; product badges do not select the chain.
NEXT_PUBLIC_MONEY_STATION_API_ORIGIN=
NEXT_PUBLIC_MONEY_STATION_ORGANIZATION_ORIGIN=
NEXT_PUBLIC_MONEY_STATION_RELAY_ORIGIN=
# Exact SharedPolicy JSON from the independently reviewed release.
NEXT_PUBLIC_MONEY_STATION_POLICY_JSON=
# SHA-256 of the canonical policy JSON, obtained independently from the API.
NEXT_PUBLIC_MONEY_STATION_POLICY_SHA256=
# Set to 1 for the release pipeline to reject missing HTTPS services/policy.
MONEY_STATION_REQUIRE_DEPLOYMENT=0
# Hackathon only: 1 enables immediate, labelled demo KYB. Default off.
NEXT_PUBLIC_MONEY_STATION_DEMO_KYB=0
